# ============================================================
#  KI-ZENTRALE – Einstellungen für das Server-Setup
#  Hier stehen KEINE Geheimnisse. Die zwei Schlüssel (Tailscale,
#  Anthropic) fragt das Skript beim Start ab – sie werden nie auf
#  deinem Mac gespeichert.
# ============================================================

# 1) Modell des Chefs (Qualität vor Preis; Kosten durch Prepaid-Guthaben gedeckelt)
CHIEF_MODEL="claude-sonnet-5-5"

# 2) Dein Benutzername auf dem Server (klein, ohne Leerzeichen)
SERVER_USER="lukas"

# 3) Name des Servers in deinem privaten Netz
SERVER_HOSTNAME="ki-zentrale"

# 4) Zeitzone
TIMEZONE="Europe/Berlin"

# 5) Hermes-Version: "stable" = geprüfte Version. Das Skript notiert
#    danach die exakte Version, damit Updates nur bewusst passieren.
HERMES_IMAGE="nousresearch/hermes-agent:stable"
